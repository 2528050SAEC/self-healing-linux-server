[Unit]
Description=Self-Healing Linux Server Monitor
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/self-healing-linux-server
ExecStart=/bin/bash /opt/self-healing-linux-server/scripts/self_heal.sh
Restart=always
RestartSec=5
Environment=SERVICE=nginx
Environment=CHECK_INTERVAL=10

[Install]
WantedBy=multi-user.target
